# Supabase project settings — find these at supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: only needed if you add server-side jobs that must bypass Row Level
# Security (e.g. a scheduled report). The app's admin dashboard does NOT need
# this — admin writes go through the logged-in admin's own session and RLS
# policies. Keep this out of NEXT_PUBLIC_* and never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
