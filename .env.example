# Supabase project connection (safe to expose to the browser — the
# publishable anon key relies entirely on Postgres RLS for security,
# never on this key being secret). Find both under Project Settings ->
# API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute production origin (no trailing slash), e.g. https://novelhousehold.com
# Used only where an absolute URL is required: sitemap.xml entries,
# robots.txt's Sitemap: line, and the password-reset email's redirect
# link. Falls back to http://localhost:3000 if unset, which is fine for
# local development but MUST be set correctly in production.
NEXT_PUBLIC_SITE_URL=
